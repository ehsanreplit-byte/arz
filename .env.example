# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB (Atlas or self-hosted)
MONGODB_URI="mongodb://127.0.0.1:27017/crypto_telegram_admin"

# JWT_SECRET: Secret key used for signing and verifying admin JWT tokens
JWT_SECRET="super_secret_jwt_key_change_in_production"

# TELEGRAM_BOT_TOKEN: Optional initial Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=""

# AVALAI_API_KEY: API Key from AvalAI (https://avalai.ir) for ChatGPT / OpenAI-compatible models
AVALAI_API_KEY=""
AVALAI_BASE_URL="https://api.avalai.ir/v1"

# ---- Automatic watchlist refresh (top market cap + most volatile, daily) ----
# WATCHLIST_AUTO_REFRESH: set to "false" to disable the daily rebuild entirely.
WATCHLIST_AUTO_REFRESH="true"
# How many coins to take from the top of the market-cap ranking.
WATCHLIST_TOP_MARKETCAP="30"
# How many ADDITIONAL coins to take from the most volatile 24h movers.
WATCHLIST_TOP_VOLATILE="20"
# Time of day (in WATCHLIST_REFRESH_TZ) when the list is rebuilt.
WATCHLIST_REFRESH_HOUR="8"
WATCHLIST_REFRESH_MINUTE="0"
WATCHLIST_REFRESH_TZ="Asia/Tehran"
# Minimum 24h quote volume (USDT) for a volatile candidate. 0 disables the filter.
WATCHLIST_MIN_QUOTE_VOLUME="1000000"



# ---- WEEX Futures API (ترید WEEX) ----
# Optional defaults. They can also be entered from the "ترید WEEX" panel,
# where the secret + passphrase are stored server-side and never returned.
WEEX_API_KEY=""
WEEX_API_SECRET=""
WEEX_API_PASSPHRASE=""
