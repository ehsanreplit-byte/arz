# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB (Atlas or self-hosted)
MONGODB_URI="mongodb://127.0.0.1:27017/crypto_telegram_admin"

# JWT_SECRET: Secret key used for signing and verifying admin JWT tokens
JWT_SECRET="super_secret_jwt_key_change_in_production"

# TELEGRAM_BOT_TOKEN: Optional initial Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=""

# AVALAI_API_KEY: API Key from AvalAI (https://avalai.ir) for ChatGPT / OpenAI-compatible models
AVALAI_API_KEY=""
AVALAI_BASE_URL="https://api.avalai.ir/v1"

# ---- WEEX Futures API (ترید WEEX) ----
# Optional defaults. They can also be entered from the "ترید WEEX" panel,
# where the secret + passphrase are stored server-side and never returned.
WEEX_API_KEY=""
WEEX_API_SECRET=""
WEEX_API_PASSPHRASE=""

# ---- موتور حد ضرر متحرک WEEX (Trailing stop) ----
# با رسیدن سود به ۶٪ حد ضرر روی نقطه ورود می‌رود، در ۱۰٪ سود ۵٪ قفل می‌شود و
# بعد هر ۵٪ صعود، حد ضرر روی پله ۵٪ قبلی قرار می‌گیرد (تا رسیدن به حد سود اصلی).
WEEX_TRAILING_STOP="true"
# مبنای درصد: "roe" = درصد سود روی مارجین (همان عددی که پنل نشان می‌دهد)، "price" = درصد حرکت قیمت
WEEX_TRAIL_BASIS="roe"
WEEX_TRAIL_BREAKEVEN_PCT="6"
WEEX_TRAIL_FIRST_LOCK_PCT="10"
WEEX_TRAIL_STEP_PCT="5"
